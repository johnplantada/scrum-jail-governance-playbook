<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.scrum-jail.supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/scrum-jail/current/bin/sjg-supervisor</string>
    <string>--config</string>
    <string>/usr/local/etc/scrum-jail/supervisor.json</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/var/log/scrum-jail-supervisor.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/scrum-jail-supervisor.log</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
