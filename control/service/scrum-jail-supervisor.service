[Unit]
Description=Scrum Jail 1.0 governance supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/scrum-jail/current/bin/sjg-supervisor --config /etc/scrum-jail/supervisor.json serve
Restart=on-failure
RestartSec=10s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/scrum-jail /run/scrum-jail /srv/scrum-jail/workspaces
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
TimeoutStopSec=30s
KillMode=mixed

[Install]
WantedBy=multi-user.target
