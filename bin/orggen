#!/usr/bin/env python3
"""Stamp one clean-break organization from the reviewed governance playbook.

The output contains desired state, mandates, issue forms, manual-only workflow templates,
unprivileged controller clients, tests, and provenance. Provider policy, credentials,
scheduler state, budgets, GitHub transport, and governance mutations remain outside the
generated workspace in an immutable installed control release.

Every roster-derived surface is generated from one canonical role list.

  orggen init <target-dir> [--org NAME] [--product NAME] [--goal GOAL]
              [--principal-github USERNAME] [--product-repo OWNER/REPO]
              [--roles project-orchestrator,commercial-planner,software-implementer,governance-reviewer]
              [--allow-dirty]

Example:
  bin/orggen init ../acme-org --product "acme.com" --goal "$10k/month" \\
      --principal-github yourhandle --product-repo yourhandle/acme
"""
import argparse
import atexit
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
INIT = os.path.join(REPO, "_init")
RUNTIME = os.path.join(REPO, "runtime")

# Docs vendored into the new org's playbook/ and covered by SOURCE.json.
VENDORED_DOCS = ["patterns.md", "safe.md", "blocker-ledger.md", "authorization-gate.md",
                 "envelopes.yaml", "README.md", "RUNBOOK.md", "org-chart.yaml",
                 "FIELD-NOTES.md", "role-terminology.md", "delegation-charter.md"]

# Canonical 1.0 role archetypes: id → (function, reports_to, model profile, worker cap,
# budget, note). Human/agent/service kinds are explicit in org-chart.yaml; names describe
# what the process actually does rather than borrowing legal corporate offices.
ARCHETYPES = {
    "project-orchestrator": ("objective-coordination", "portfolio-orchestrator",
                             "standard", 0, 300000,
                             "Coordinates assigned objectives; it does not spawn worker teams"),
    "commercial-planner":   ("commercial-planning", "project-orchestrator",
                             "standard", 4, 500000,
                             "May spawn bounded task workers within this cap"),
    "software-implementer": ("software-delivery", "project-orchestrator",
                             "standard", 4, 500000,
                             "May spawn bounded task workers within this cap"),
    "policy-reviewer":      ("policy-review", "human-principal", "standard", 4, 500000,
                             "Independent reviewer; may spawn evidence researchers"),
    "governance-reviewer":  ("governance-judgment", "human-principal", "fast", 0, 100000,
                             "Handles only judgment residue from the deterministic governance monitor"),
}

DEFAULT_ROLES = ["project-orchestrator", "commercial-planner",
                 "software-implementer", "governance-reviewer"]
ALLOWED_ROLES = frozenset(DEFAULT_ROLES + ["policy-reviewer"])

# Governance review cannot be dropped. The deterministic monitor owns mechanical truth;
# the reviewer handles only residue and reports outside the production chain.
GOVERNANCE_REVIEWER = "governance-reviewer"
ROLE_ID = re.compile(r"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$")


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(path, 0o644)


def fill(text, **kv):
    for k, v in kv.items():
        text = text.replace("{{" + k + "}}", str(v)).replace("__" + k + "__", str(v))
    return text


def roles(spec):
    """Return canonical role tuples used by every generated roster surface.

    The governance reviewer is guaranteed exactly once, last. --roles chooses the
    project execution shape, never whether the deterministic governance monitor can
    escalate judgment residue. Guaranteed here so every consumer of the roster — chart
    blocks, mandates, wake rules, and max-agents arithmetic sees the same list."""
    names = ([s.strip() for s in spec.split(",") if s.strip()]
             if spec else list(DEFAULT_ROLES))
    seen = set()
    for name in names:
        if not ROLE_ID.fullmatch(name):
            sys.exit(f"orggen: invalid role id {name!r}; use lowercase kebab-case "
                     "([a-z][a-z0-9-]*)")
        if name in seen:
            sys.exit(f"orggen: duplicate role id {name!r}")
        seen.add(name)
    unknown = set(names) - ALLOWED_ROLES
    if unknown:
        sys.exit("orggen: unknown canonical role(s): " + ", ".join(sorted(unknown)))
    missing = set(DEFAULT_ROLES) - set(names)
    if missing:
        sys.exit("orggen: missing required role(s): " + ", ".join(sorted(missing)))
    names = [n for n in names if n != GOVERNANCE_REVIEWER] + [GOVERNANCE_REVIEWER]
    out = []
    for name in names:
        role, reports_to, model, max_sub, budget, note = ARCHETYPES[name]
        out.append((name, role, reports_to, model, max_sub, budget, note))
    return out


def role_mandate_path(target, name):
    """Resolved agents/<role>.md path, with containment checked at the write boundary."""
    agents_root = os.path.realpath(os.path.join(target, "agents"))
    candidate = os.path.realpath(os.path.join(agents_root, f"{name}.md"))
    if os.path.commonpath((agents_root, candidate)) != agents_root:
        sys.exit(f"orggen: role id {name!r} escapes the generated agents directory")
    return candidate


def role_block(name, role, reports_to, model_profile, max_sub, budget, note):
    """One org-chart roles: entry, generated from the same tuple that stamps the agent
    mandate — so the chart and agents/ can never disagree about who exists."""
    is_orchestrator = name == "project-orchestrator"
    is_governance_reviewer = name == GOVERNANCE_REVIEWER
    max_per_wake = 0 if (is_orchestrator or is_governance_reviewer) else max_sub
    max_concurrent = min(max_per_wake, 2)
    allowed = ("[]" if max_per_wake == 0 else
               "[researcher, drafter, implementer]" if name == "software-implementer"
               else "[researcher, drafter]")
    preamble = (
        "  # Judgment residue from the deterministic governance-monitor service. Reports\n"
        "  # to the Human Principal so the production chain cannot suppress its findings.\n"
        "  # The service engine is token-free; this agent handles only ambiguous residue.\n"
        "  # handles what the script flags, hence the org's smallest envelope.\n"
        "  # REQUIRES global.principal_queue_issue to be pinned — see RUNBOOK commissioning.\n"
        if is_governance_reviewer else ""
    )
    return (
        f"  # ── {name.upper()} ────────────────────────────────\n"
        f"{preamble}"
        f"  - name: {name}\n"
        f"    kind: agent\n"
        f"    scope: project\n"
        f"    lifetime: resumable\n"
        f"    role: {role}\n"
        f"    reports_to: {reports_to}\n"
        f"    model_profile: {model_profile}       # fast|standard|deep; provider maps it to a model id\n"
        f"    workers:\n"
        f"      allowed: {allowed}\n"
        f"      max_per_wake: {max_per_wake}         # cumulative; completion never restores it\n"
        f"      max_concurrent: {max_concurrent}      # active worker processes\n"
        f"    envelope:\n"
        f"      daily_token_budget: {budget}\n"
        f"      can_spend: false\n"
        f"      can_deploy: false\n"
    )


def wake_rules(role_specs):
    """The controller's desired routing table. First matching rule wins.
    role:* labels route issues, comments, and PRs to their owner; an issue with NO role:*
    label falls through to the governance reviewer, who triages it and adds the routing label (the
    reference org's lesson: a web-form issue carrying only a kind label woke nobody and
    sat invisible — patterns.md Pattern 16); unlabeled PRs default by repo (org → the
    project orchestrator; product → the software-delivery role
    owner); product workflow runs wake the software-delivery role."""
    names = [d[0] for d in role_specs]
    supply = next((n for n, r, *_ in role_specs if r == "software-delivery"),
                  "project-orchestrator")
    head = (
        "# Wake rules — controller desired state (generated by orggen from the roster).\n"
        "# edit freely — it is data, reviewed like everything else).\n"
        "#\n"
        "# The installed supervisor collects complete GitHub snapshots, normalizes durable\n"
        "# events, and applies this table. Workspace runner.py is only an operator client.\n"
        "#\n"
        "# Event fields a rule can match (all optional; a rule matches when every given field does):\n"
        "#   kind:     issue | pr | comment | run\n"
        "#   repo:     org | product\n"
        "#   label:    a label present on the item (e.g. role:software-implementer)\n"
        "#   workflow: the workflow file name, for kind: run (e.g. deploy.yml)\n"
        "#   conclusion: success | failure — for kind: run\n"
        "#   pr_state: open | merged | closed — for kind: pr (merged vs closed-without-merge)\n"
        "#\n"
        '# wake: a role id, or "from-label" to route to the item\'s role:* label.\n'
        "# First matching rule wins. An issue with no role:* label falls through to the governance reviewer\n"
        "# (the catch-all below — it triages and adds the routing label); other kinds that\n"
        "# match nothing wake nobody (logged; shadow mode logs the would-be wakes).\n"
        "\n"
        "rules:\n"
        "  # Work injection + ticket traffic: whoever the role:* label names owns the wake.\n"
    )
    issue_rules = "".join(
        f'  - match: {{kind: issue, label: "role:{n}"}}\n    wake: from-label\n'
        for n in names)
    # Catch-all for unroutable work: an issue matching no role:* rule above would
    # otherwise wake nobody and sit invisible — the reference org's Human Principal filed a
    # follow-up through the web form with only a kind label, and the ask went
    # unactioned for hours until a peer traced the gap by hand. Governance review is mandatory
    # every org has, and this triage is in its charter ("an unroutable issue whose owner
    # is clear → add the label"); its label then wakes the owning role.
    catchall_rule = (
        "  # Catch-all: an unlabeled issue routes to the governance reviewer for triage.\n"
        "  # It adds the role:* label that wakes the accountable role.\n"
        "  - match: {kind: issue}\n"
        "    wake: governance-reviewer\n")
    comment_rule = ("  - match: {kind: comment}\n"
                    "    wake: from-label          # a comment on a routed issue re-wakes its owner\n")
    pr_head = (
        "\n"
        "  # PR traffic (the reference org's lesson: the Human Principal merged a charter and nobody\n"
        "  # woke). A role:* label wins, same contract as issues; an unlabeled PR defaults by\n"
        "  # repo — org PRs are org-shape work (the Project Orchestrator acts on a Human Principal merge\n"
        f"  # un-parks), product PRs belong to {supply} (the pipeline owner). Every PR bump\n"
        "  # routes — opened, merged, and closed alike; pr_state is there for finer-grained rules.\n"
    )
    pr_rules = "".join(
        f'  - match: {{kind: pr, label: "role:{n}"}}\n    wake: from-label\n'
        for n in names)
    pr_defaults = (
        "  - match: {kind: pr, repo: org}\n"
        "    wake: project-orchestrator\n"
        "  - match: {kind: pr, repo: product}\n"
        f"    wake: {supply}\n")
    run_rules = (
        "\n"
        "  # Deploy state changes: merged ≠ live must stay loud.\n"
        "  - match: {kind: run, repo: product, workflow: deploy.yml}\n"
        f"    wake: {supply}\n"
        "\n"
        f"  # The review loop: evidence/review runs wake {supply} to act on verdicts.\n"
        "  - match: {kind: run, repo: product, workflow: code-review.yml}\n"
        f"    wake: {supply}\n"
        "  - match: {kind: run, repo: product, workflow: demo-evidence.yml, conclusion: failure}\n"
        f"    wake: {supply}\n")
    return (head + issue_rules + catchall_rule + comment_rule + pr_head + pr_rules
            + pr_defaults + run_rules)


def role_options(role_specs, for_objective=False):
    """Issue-form role dropdown options: executing roles only. The governance reviewer
    is not a work-intake target; the project orchestrator appears only on objectives."""
    if for_objective:
        return "        - project-orchestrator"
    lines = [f"        - {n}" for n, *_ in role_specs
             if n not in ("project-orchestrator", GOVERNANCE_REVIEWER)]
    return "\n".join(lines)


def _ignored(path):
    relative = os.path.relpath(path, REPO)
    result = subprocess.run(["git", "-C", REPO, "check-ignore", "-q", "--", relative],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0


def reject_symlink_components(path, *, containment_root=None):
    candidate = os.path.abspath(path)
    repository = os.path.abspath(containment_root or REPO)
    if os.path.commonpath((repository, candidate)) != repository:
        sys.exit(f"orggen: stamp input escapes the golden repository: {path}")
    relative = os.path.relpath(candidate, repository)
    current = repository
    for component in (() if relative == "." else relative.split(os.sep)):
        current = os.path.join(current, component)
        if os.path.islink(current):
            sys.exit(f"orggen: refusing symlinked stamp input: {os.path.relpath(current, repository)}")


def copy_tree(src, dst, *, containment_root=None):
    trusted_root = containment_root or REPO
    reject_symlink_components(src, containment_root=trusted_root)
    for root, dirs, files in os.walk(src):
        reject_symlink_components(root, containment_root=trusted_root)
        dirs[:] = [d for d in dirs if d != "__pycache__" and not _ignored(os.path.join(root, d))]
        rel = os.path.relpath(root, src)
        for f in files:
            s = os.path.join(root, f)
            if _ignored(s):
                continue
            if os.path.islink(s):
                sys.exit(f"orggen: refusing symlinked stamp input: {os.path.relpath(s, REPO)}")
            reject_symlink_components(s, containment_root=trusted_root)
            d = os.path.join(dst, rel, f) if rel != "." else os.path.join(dst, f)
            os.makedirs(os.path.dirname(d), exist_ok=True)
            shutil.copy2(s, d)


def source_tree_digest():
    """Hash the files orggen can stamp so a dirty development snapshot is identifiable."""
    import yaml
    manifest_path = os.path.join(REPO, "stamp-manifest.yaml")
    with open(manifest_path, encoding="utf-8") as handle:
        manifest = yaml.safe_load(handle) or {}
    roots = [os.path.join(REPO, str(p)) for p in manifest.get("source_roots") or []]
    if not roots or any(not os.path.exists(path) for path in roots):
        sys.exit("orggen: stamp-manifest.yaml has an absent or empty source_roots entry")
    files = []
    for root in roots:
        reject_symlink_components(root)
        if os.path.isfile(root):
            files.append(root)
            continue
        for directory, dirs, names in os.walk(root):
            if os.path.islink(directory):
                sys.exit(f"orggen: refusing symlinked stamp input: {os.path.relpath(directory, REPO)}")
            linked_dirs = [name for name in dirs if os.path.islink(os.path.join(directory, name))]
            if linked_dirs:
                linked = os.path.join(directory, linked_dirs[0])
                sys.exit(f"orggen: refusing symlinked stamp input: {os.path.relpath(linked, REPO)}")
            dirs[:] = sorted(d for d in dirs if d != "__pycache__"
                            and not _ignored(os.path.join(directory, d)))
            for name in sorted(names):
                path = os.path.join(directory, name)
                if name.endswith((".pyc", ".pyo")) or _ignored(path):
                    continue
                if os.path.islink(path):
                    sys.exit(f"orggen: refusing symlinked stamp input: {os.path.relpath(path, REPO)}")
                reject_symlink_components(path)
                files.append(path)
    digest = hashlib.sha256()
    for path in sorted(set(files)):
        digest.update(os.path.relpath(path, REPO).encode("utf-8"))
        digest.update(b"\0")
        with open(path, "rb") as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(chunk)
        digest.update(b"\0")
    return digest.hexdigest()


def golden_provenance(allow_dirty=False):
    """Return (commit, state, source digest), refusing unreproducible stamps by default."""
    try:
        commit = subprocess.run(
            ["git", "-C", REPO, "rev-parse", "HEAD"], capture_output=True,
            text=True, check=True).stdout.strip()
        status = subprocess.run(
            ["git", "-C", REPO, "status", "--porcelain", "--untracked-files=all",
             "--", ".", ":(exclude).worktrees/**"],
            capture_output=True, text=True, check=True).stdout
    except subprocess.CalledProcessError as exc:
        sys.exit(f"orggen: cannot establish golden provenance: {exc}")
    state = "dirty" if status.strip() else "clean"
    if state == "dirty" and not allow_dirty:
        sys.exit("orggen: the governance golden has tracked or untracked changes; refusing "
                 "an unreproducible release stamp. Commit the golden, or use --allow-dirty "
                 "for an explicitly non-release development stamp.")
    return commit, state, source_tree_digest()


def validate_scalar(name, value, *, maximum=200):
    value = str(value)
    if not value or len(value) > maximum or any(ord(ch) < 32 for ch in value):
        sys.exit(f"orggen: {name} is empty, too long, or contains control characters")
    if "{{" in value or "}}" in value or "__" in value:
        sys.exit(f"orggen: {name} contains a template delimiter")
    return value


def organization_document(org, principal, org_repo, product_repo, role_specs, *, source_digest,
                          global_max_agents):
    """Portable desired state. JSON is intentionally emitted: JSON is valid YAML and
    gives every scalar an unambiguous structured encoding."""
    agents = []
    for name, _function, _reports_to, _model, max_workers, budget, _note in role_specs:
        allowed = ([] if max_workers == 0 else
                   (["researcher", "drafter", "implementer"]
                    if name == "software-implementer" else ["researcher", "drafter"]))
        repositories = ["org", "product"] if name == "software-implementer" else ["org"]
        agents.append({
            "id": name,
            "repositories": repositories,
            "dailyTokenBudget": budget,
            "workers": {
                "allowed": allowed,
                "maxPerWake": max_workers,
                "maxConcurrent": min(max_workers, 2),
            },
        })
    return {
        "apiVersion": "scrum-jail.dev/v1",
        "kind": "Organization",
        "metadata": {"id": org},
        "authority": {
            "principalRole": "human-principal",
            "principalGitHub": principal,
            "upstreamRole": "portfolio-orchestrator",
        },
        "repositories": {
            "org": {"slug": org_repo, "defaultBranch": "main"},
            "product": {"slug": product_repo, "defaultBranch": "main"},
        },
        "controlRelease": {
            "version": read(os.path.join(REPO, "VERSION")).strip(),
            "sourceTreeSha256": source_digest,
        },
        "budgets": {"organizationDailyTokens": 2_000_000},
        "limits": {"globalMaxAgents": global_max_agents},
        "agents": agents,
        "workflows": {"hostedExecution": "manual-only", "principalActor": principal},
    }


def output_manifest(target):
    files = []
    for directory, dirs, names in os.walk(target):
        dirs.sort()
        for name in sorted(names):
            path = os.path.join(directory, name)
            if os.path.islink(path) or not os.path.isfile(path):
                sys.exit(f"orggen: generated output contains a non-regular file: {path}")
            rel = os.path.relpath(path, target)
            if rel == "playbook/SOURCE.json":
                continue
            digest = hashlib.sha256()
            with open(path, "rb") as handle:
                for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                    digest.update(chunk)
            files.append({
                "path": rel,
                "mode": format(stat.S_IMODE(os.stat(path).st_mode), "04o"),
                "sha256": digest.hexdigest(),
            })
    payload = hashlib.sha256(json.dumps(files, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    return files, payload


def validate_output(target, role_specs):
    import yaml

    unresolved = re.compile(r"(?<!\$){{[A-Z0-9_]+}}|__[A-Z0-9_]+__")
    for directory, _dirs, names in os.walk(target):
        for name in names:
            path = os.path.join(directory, name)
            if name.endswith((".yaml", ".yml")):
                with open(path, encoding="utf-8") as handle:
                    yaml.safe_load(handle)
            if name.endswith(".json"):
                with open(path, encoding="utf-8") as handle:
                    json.load(handle)
            rel = os.path.relpath(path, target)
            is_template = name == "role.tmpl.md" or rel.startswith("scripts/templates/")
            if (name.endswith((".md", ".yaml", ".yml", ".json", ".toml", ".example"))
                    and not is_template):
                with open(path, encoding="utf-8") as handle:
                    if unresolved.search(handle.read()):
                        sys.exit(f"orggen: unresolved template token in {os.path.relpath(path, target)}")
    with open(os.path.join(target, "org-chart.yaml"), encoding="utf-8") as handle:
        chart = yaml.safe_load(handle) or {}
    chart_roles = [entry.get("name") for entry in chart.get("roles") or []]
    expected = [entry[0] for entry in role_specs]
    if chart_roles != expected:
        sys.exit("orggen: generated org-chart roster does not match the canonical roster")
    mandates = sorted(name[:-3] for name in os.listdir(os.path.join(target, "agents"))
                      if name.endswith(".md") and not name.startswith("_")
                      and name != "role.tmpl.md")
    if mandates != sorted(expected):
        sys.exit("orggen: generated mandate roster does not match the canonical roster")
    control_path = os.path.join(REPO, "control")
    if control_path not in sys.path:
        sys.path.insert(0, control_path)
    from sjg_control.policy import PolicyError, compile_policy
    try:
        with open(os.path.join(target, "organization.yaml"), encoding="utf-8") as handle:
            organization = yaml.safe_load(handle)
        policy = compile_policy(organization, source_commit="generator-validation")
    except (OSError, PolicyError, ValueError, TypeError) as exc:
        sys.exit(f"orggen: generated organization policy is not compilable: {exc}")
    if list(policy.roles) != expected:
        sys.exit("orggen: compiled organization policy roster differs from generated surfaces")


def cmd_init(args):
    source_commit, source_state, source_digest = golden_provenance(args.allow_dirty)
    final_target = os.path.abspath(args.target)
    if os.path.exists(final_target):
        sys.exit(f"orggen: target '{final_target}' already exists — refusing to overwrite.")
    source_root = os.path.realpath(REPO)
    resolved_target = os.path.realpath(final_target)
    if os.path.commonpath((source_root, resolved_target)) == source_root:
        sys.exit("orggen: target must be outside the golden repository")
    parent = os.path.dirname(final_target)
    os.makedirs(parent, exist_ok=True)
    target = tempfile.mkdtemp(prefix=f".{os.path.basename(final_target)}.staging-", dir=parent)
    cleanup = lambda: shutil.rmtree(target, ignore_errors=True)
    atexit.register(cleanup)
    org = validate_scalar("org", args.org or os.path.basename(final_target.rstrip("/")), maximum=64)
    if not ROLE_ID.fullmatch(org):
        sys.exit("orggen: org must be lowercase kebab-case")
    product = validate_scalar("product", args.product or org)
    goal = validate_scalar("goal", args.goal or "<YOUR GOAL — e.g. $10k/month>", maximum=500)
    principal = args.principal_github or "YOUR_GITHUB_USERNAME"
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})", principal):
        sys.exit("orggen: --principal-github must be a valid GitHub login")
    org_gh_repo = f"{principal}/{org}"
    product_gh_repo = args.product_repo or f"{principal}/product-repo"
    if (not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", product_gh_repo)
            or any(component in {".", ".."} for component in product_gh_repo.split("/"))):
        sys.exit("orggen: --product-repo must be OWNER/REPO")
    role_specs = roles(args.roles)
    # Parent sessions plus the explicitly concurrent named-worker caps.
    max_agents = sum(1 + min(d[4], 2) for d in role_specs)

    # 1. The RUNTIME, verbatim (scripts/, .claude/, .github/workflows, Makefile,
    #    decisions.yaml seed, .gitignore — stored dot-less in the golden).
    copy_tree(RUNTIME, target)
    # Codex discovers repository skills under .agents/skills; Claude discovers the same
    # canonical sources under .claude/skills. Stamp both views from one source tree.
    copy_tree(os.path.join(target, ".claude", "skills"),
              os.path.join(target, ".agents", "skills"), containment_root=target)
    write(os.path.join(target, "VERSION"), read(os.path.join(REPO, "VERSION")))
    write(os.path.join(target, "LICENSE"), read(os.path.join(REPO, "LICENSE")))
    os.rename(os.path.join(target, "gitignore"), os.path.join(target, ".gitignore"))
    for sh in ("scripts", os.path.join("scripts", "hooks")):
        d = os.path.join(target, sh)
        for f in os.listdir(d):
            p = os.path.join(d, f)
            if os.path.isfile(p) and (f.endswith(".sh") or f.startswith("pre-")
                                      or f in {"worker-run", "verify-provenance.py"}):
                os.chmod(p, 0o755)

    # 2. The vendored playbook/ — this golden's docs, integrity-covered by SOURCE.json.
    for doc in VENDORED_DOCS:
        src = os.path.join(REPO, doc)
        if os.path.exists(src):
            write(os.path.join(target, "playbook", doc), read(src))
    write(os.path.join(target, "playbook", "SOURCE.md"),
          "# Vendored snapshot\n\nplaybook/ mirrors the governance golden. Do not hand-edit the\n"
          "vendored docs — change them in the golden and stamp a new organization.\n\n"
          f"Source: scrum-jail-governance-playbook @ {source_commit}\n"
          f"Source-State: {source_state}\n"
          f"Source-Tree-SHA256: {source_digest}\n"
          f"Vendored files: {' '.join(VENDORED_DOCS)}\n")

    # 3. org-chart.yaml — the roles: block, the roster-derived agent ceiling, and the
    #    cadences, from the SAME dept list that stamps the mandates below.
    # The governance reviewer rides in the roster itself — roles() guarantees it exactly once,
    # last, so the chart, mandates, wake rules, and max-agents all see the same roster.
    role_blocks = "\n".join(role_block(*d) for d in role_specs)
    chart = fill(read(os.path.join(INIT, "org-chart.yaml")),
                 PRODUCT=product, PRINCIPAL_GITHUB=principal, ROLES=role_blocks,
                 GLOBAL_MAX_AGENTS=max_agents,
                 REVIEW_INTERVAL="20", PI_INTERVAL="3", UNLOCK_WIP_LIMIT="5")
    write(os.path.join(target, "org-chart.yaml"), chart)
    write(os.path.join(target, "organization.yaml"),
          json.dumps(organization_document(org, principal, org_gh_repo, product_gh_repo,
                                           role_specs, source_digest=source_digest,
                                           global_max_agents=max_agents),
                     indent=2, ensure_ascii=False) + "\n")

    # 4. Constitution + vision + ledgers (substituted from _init/).
    write(os.path.join(target, "DESIGN.md"),
          fill(read(os.path.join(INIT, "DESIGN.md")), PRODUCT=product, GOAL=goal))
    write(os.path.join(target, "VISION.md"),
          fill(read(os.path.join(INIT, "VISION.md")), PRODUCT=product, GOAL=goal))
    write(os.path.join(target, "blockers.yaml"), read(os.path.join(INIT, "blockers.yaml")))
    # 5. wake-rules.yaml — generated from the roster.
    write(os.path.join(target, "wake-rules.yaml"), wake_rules(role_specs))

    # 6. .github/ — CODEOWNERS routes decisions.yaml to the Human Principal; issue-form
    #    role dropdowns come from the canonical roster.
    gh_init = os.path.join(INIT, "github")
    write(os.path.join(target, ".github", "CODEOWNERS"),
          fill(read(os.path.join(gh_init, "CODEOWNERS")), PRINCIPAL_GITHUB=principal))
    tmpl_dir = os.path.join(gh_init, "ISSUE_TEMPLATE")
    for f in sorted(os.listdir(tmpl_dir)):
        text = fill(read(os.path.join(tmpl_dir, f)),
                    ORG_GH_REPO=org_gh_repo,
                    ROLE_OPTIONS=role_options(role_specs, for_objective=(f == "objective.yml")))
        write(os.path.join(target, ".github", "ISSUE_TEMPLATE", f), text)

    # 7. Agents: the shared policy, one mandate per canonical role, and the reusable role template.
    write(os.path.join(target, "agents", "_policy.md"), read(os.path.join(INIT, "agents", "_policy.md")))
    tmpl = read(os.path.join(INIT, "agents", "role.tmpl.md"))
    write(os.path.join(target, "agents", "role.tmpl.md"), fill(tmpl, PRODUCT=product))
    for name, role, reports_to, *_ in role_specs:
        role_tmpl = os.path.join(INIT, "agents", f"{name}.md")
        base = read(role_tmpl) if os.path.exists(role_tmpl) else tmpl
        mandate = fill(base, NAME=name, ROLE=role, REPORTS_TO=reports_to,
                       PRODUCT=product, GOAL=goal)
        write(role_mandate_path(target, name), mandate)
    # 8. A short README for the new org.
    write(os.path.join(target, "README.md"), org_readme(org, product, role_specs))

    validate_output(target, role_specs)
    files, payload_digest = output_manifest(target)
    provenance = {
        "schemaVersion": 1,
        "sourceCommit": source_commit,
        "sourceState": source_state,
        "sourceTreeSha256": source_digest,
        "payloadTreeSha256": payload_digest,
        "releaseQualified": source_state == "clean",
        "files": files,
    }
    write(os.path.join(target, "playbook", "SOURCE.json"),
          json.dumps(provenance, indent=2, sort_keys=True) + "\n")
    os.replace(target, final_target)
    atexit.unregister(cleanup)
    target = final_target

    print(f"✓ stamped {org} → {target}")
    print(f"  product: {product}   human principal: {principal}   roles: {', '.join(d[0] for d in role_specs)}")
    print(f"  org repo: {org_gh_repo}   product repo: {product_gh_repo}")
    print(f"  global_max_agents: {max_agents} (every brain + its fan-out — raising it is a charter act)")
    print(f"  source: {source_commit[:12]} ({source_state})")
    if source_state == "dirty":
        print("  WARNING: development stamp from a dirty golden; do not publish as a release.")
    print("\nNext steps:")
    print("  1. Create the local validation environment and run `make test`.")
    print("  2. Have an operator install, verify, and commission the matching control release.")
    print("     Subscription/OAuth homes, GitHub App credentials, models, and state stay outside")
    print("     this repository; provider API keys and shared Human credentials are forbidden.")
    print("  3. The Human Principal commissions repository protection and the manual-only,")
    print("     SHA-bound review/demo/deploy workflows, then verifies those settings read-only.")
    print("  4. The Human Principal files the first [OBJECTIVE]. Run a controller preview tick")
    print("     before enabling live delivery. See playbook/RUNBOOK.md for the complete checklist.")


def org_readme(org, product, role_specs):
    rows = "\n".join(f"| {n} | {r} | `role:{n}` |" for n, r, *_ in role_specs)
    return f"""# {org} — governed agent organization

A governance-gated multi-agent org for **{product}**, stamped from the
[scrum-jail-governance-playbook](https://github.com/johnplantada/scrum-jail-governance-playbook)
— desired state and unprivileged client surface only. The immutable controller, provider
policy, credentials, scheduler, budgets, and mutation logic are installed outside this repo.

GitHub-native: work is Issues + one Project, wakes route on `role:*` labels
(`wake-rules.yaml`). Only the Human Principal creates objectives, merges pull requests,
dispatches or deploys, authorizes and executes spending, changes settings, or activates
governance. See `DESIGN.md` and `organization.yaml`.

## Agent roles

| Agent | Role | Wake label |
|---|---|---|
{rows}

## Governance & operability docs
- `DESIGN.md` — enforceable authority and failure rules
- `VISION.md` — the one-page why + who
- `organization.yaml` — compiled controller policy and release binding
- `org-chart.yaml` — human-readable roster and envelopes
- `blockers.yaml` — the EV-ordered human-task ledger (the Human Principal's queue)
- `decisions.yaml` — proposals and Human decision record; it executes nothing
- `playbook/` — provenance-bound governance documentation

## Operate
`make` prints the operator surface: `tick` / `preview` / `logs` / `halt` / `resume` /
`blockers` / `governance-monitor` / `governance-monitor-sync` / `test` / `install-hooks` /
`check-playbook`.

## Setup
1. `git init`; create the venv, install `scripts/requirements.txt`, then run `make test`.
2. Install and commission the exact control release named by `organization.yaml`.
3. Authenticate controller-owned Codex/Claude homes with subscription/OAuth and commission
   a least-privilege GitHub service identity. Never place those credentials here.
4. The Human Principal configures branch protection and manual-only, SHA-bound workflows.
5. Run a controller preview tick, file the first `[OBJECTIVE]`, then enable live delivery.
"""


def main():
    p = argparse.ArgumentParser(prog="orggen", description="Stamp a governance-gated agent org.")
    sub = p.add_subparsers(dest="cmd", required=True)
    pi = sub.add_parser("init", help="stamp a new org skeleton into <target-dir>")
    pi.add_argument("target", help="directory to create the new org in")
    pi.add_argument("--org", help="org name (default: target dir name); also the org repo name")
    pi.add_argument("--product", help="the product the org runs (default: org name)")
    pi.add_argument("--goal", help="the org's north-star goal, e.g. '$10k/month' (default: placeholder)")
    pi.add_argument("--principal-github", help="Human Principal GitHub username — decision authority")
    pi.add_argument("--product-repo", help="owner/repo of the product repo agents PR into "
                                           "(default: <principal>/<product-repo> placeholder)")
    pi.add_argument("--roles", help="comma-separated canonical roles; all four required roles "
                                    "must be present and policy-reviewer is the only optional role")
    pi.add_argument("--allow-dirty", action="store_true",
                    help="allow a development-only stamp from a dirty golden and record it as such")
    pi.set_defaults(func=cmd_init)
    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
