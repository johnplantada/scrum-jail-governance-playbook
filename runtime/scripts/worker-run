#!/usr/bin/env bash
# Request one bounded, supervisor-selected Luna worker. Workers receive no broker socket
# and cannot recurse. Limits are cumulative and transactional in the control database.
set -euo pipefail
client="${SJGCTL_BIN:-/usr/local/libexec/scrum-jail/current/bin/sjgctl}"
[ -x "$client" ] || { echo "worker-run: installed control client not found: $client" >&2; exit 69; }
[ -n "${SJG_WAKE_SOCKET:-}" ] || { echo "worker-run: SJG_WAKE_SOCKET is not set" >&2; exit 77; }
exec "$client" worker "$@"
